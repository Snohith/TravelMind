# Supabase (frontend auth + saved itineraries)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_paste_yours_here

# Spring Boot backend (expense splits + trip rules). The Next.js server layer
# sets X-User-Id from the Supabase session — browsers never mint it directly.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
